{% block _header_custom_styles_widget %}
    <style>
        /* =============================================
           Spot7 – Lexend Exa (lokal gehostet, kein CDN)
           ============================================= */

        /* latin-ext (für DE/FR Sonderzeichen) */
        @font-face {
            font-family: 'Lexend Exa';
            font-style: normal;
            font-weight: 100 900;
            font-display: swap;
            src: url('/fonts/lexend-exa/lexend-exa-latin-ext.woff2') format('woff2');
            unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
        }
        /* latin */
        @font-face {
            font-family: 'Lexend Exa';
            font-style: normal;
            font-weight: 100 900;
            font-display: swap;
            src: url('/fonts/lexend-exa/lexend-exa-latin.woff2') format('woff2');
            unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }

        /* =============================================
           Spot7 Header Customization
           Primaerfarbe: Weiss | Sekundaerfarbe: #19a6ff
           ============================================= */

        /* Lexend Exa global für den gesamten Storefront */
        html, body, .body {
            font-family: 'Lexend Exa', system-ui, sans-serif !important;
            letter-spacing: -0.01em !important;
        }

        /* Headlines exakt wie spot7.eu CI */
        h1, .h1 {
            font-family: 'Lexend Exa', system-ui, sans-serif !important;
            font-weight: 900 !important;
            letter-spacing: -0.05em !important;
            line-height: 1.05 !important;
        }

        h2, .h2 {
            font-family: 'Lexend Exa', system-ui, sans-serif !important;
            font-weight: 900 !important;
            letter-spacing: -0.04em !important;
            line-height: 1.1 !important;
        }

        h3, .h3 {
            font-family: 'Lexend Exa', system-ui, sans-serif !important;
            font-weight: 600 !important;
            letter-spacing: -0.03em !important;
            line-height: 1.15 !important;
        }

        :root {
            --spot7-font: 'Lexend Exa', system-ui, sans-serif;
            /* Header-Hintergrund: Weiss */
            --page-header-background-color: #ffffff;

            /* Primaerfarben auf #19a6ff setzen */
            --primary-main: #19a6ff;
            --primary-hover: #0d8fdf;
            --primary-active: #0a7bc4;
            --primary-light: #e6f4ff;
        }

        /* --- Header: Weisser Hintergrund + dunkler Text --- */
        .page-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e0e0e0;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
        }

        /* Middlebar (Logo-Zeile): dunkle Schriftfarbe */
        .page-header .middlebar,
        .page-header .middlebar a,
        .page-header .middlebar__right,
        .page-header .middlebar__left {
            color: #1a1a1a;
        }

        /* Topbar: dunkle Schriftfarbe */
        .page-header .topbar,
        .page-header .topbar a {
            color: #1a1a1a;
        }

        /* Navigation-Links im Header */
        .page-header .navigation-menu--inverse .navigation-menu__link {
            color: #1a1a1a;
        }

        .page-header .navigation-menu--inverse .navigation-menu__link:hover {
            color: #19a6ff;
        }

        /* --- Buttons im Header: von inverse/dunkel auf hell umstellen --- */
        .page-header .btn {
            color: #1a1a1a;
        }

        .page-header .btn:hover,
        .page-header .btn:focus {
            color: #19a6ff;
        }

        /* Hamburger-Menu-Trigger */
        .page-header .main-menu-trigger {
            color: #1a1a1a;
        }

        .page-header .main-menu-trigger:hover {
            color: #19a6ff;
        }

        /* --- Icons im Header: dunkle Farbe --- */
        .page-header .theme-icon {
            color: #1a1a1a;
        }

        .page-header .btn:hover .theme-icon,
        .page-header .btn:focus .theme-icon {
            color: #19a6ff;
        }

        /* --- Suchfeld Anpassung --- */
        .page-header .search-widget__input {
            border-color: #d0d0d0;
            background-color: #f5f5f5;
            color: #1a1a1a;
        }

        .page-header .search-widget__input:focus {
            border-color: #19a6ff;
            background-color: #ffffff;
        }

        /* --- Logo Groesse anpassen --- */
        .page-header .logo {
            max-width: 180px;
            max-height: 50px;
        }

        .page-header .logo-img {
            object-fit: contain;
        }

        /* =============================================
           Spot7 Dashboard Customization
           Quick Access Menu + Scorecards
           ============================================= */

        /* --- Dashboard Quick Access Menu (My Profile, Order History, etc.) ---
             #214061 leicht verblasst (85% Deckkraft) --- */
        .dashboard-menu__link {
            background-color: rgba(33, 64, 97, 0.85);
        }

        .dashboard-menu__link:hover,
        .dashboard-menu__link:focus {
            background-color: rgba(33, 64, 97, 1);
        }

        /* --- Dashboard Scorecards (Users, Shopping Lists, Open RFQs) ---
             #214061 staerker verblasst (20% Deckkraft) --- */
        .dashboard-scorecards-container {
            background-color: rgba(33, 64, 97, 0.12);
            border-color: rgba(33, 64, 97, 0.3);
        }

        .dashboard-scorecard-link__metric {
            color: #214061;
        }

        .dashboard-scorecard-link__label {
            color: rgba(33, 64, 97, 0.75);
        }

        .dashboard-scorecard-link:hover {
            background-color: rgba(33, 64, 97, 0.85);
        }

        .dashboard-scorecard-link:hover .dashboard-scorecard-link__metric,
        .dashboard-scorecard-link:hover .dashboard-scorecard-link__label {
            color: #ffffff;
        }

        /* --- Scorecard Trennlinien --- */
        .dashboard-scorecards-container__item + .dashboard-scorecards-container__item {
            border-left-color: rgba(33, 64, 97, 0.2);
        }

        /* =============================================
           Spot7 Sidebar Navigation (Account-Bereich)
           ============================================= */

        /* --- Aktiver Menüpunkt: linker Balken --- */
        .primary-menu__item--current {
            border-left-color: #19a6ff;
        }

        /* --- Aktiver Menüpunkt: Hintergrund --- */
        .primary-menu__link--current,
        .primary-menu__item--current .primary-menu__link {
            background-color: #d3f3ff;
            color: #19a6ff;
        }

        /* --- Hover auf Menüpunkte --- */
        .primary-menu__link:hover {
            background-color: rgba(25, 166, 255, 0.08);
            color: #19a6ff;
        }

        /* --- Breadcrumb-Links im Account-Bereich --- */
        .breadcrumbs__link {
            color: #19a6ff;
        }

        /* =============================================
           Spot7 Customer Dropdown Menu
           ============================================= */

        /* --- Aktiver Menuepunkt im Kunden-Dropdown: Textfarbe + linker Balken --- */
        .dropdown-item--active {
            color: #19a6ff;
        }

        .dropdown-item--active:before {
            background-color: #19a6ff;
        }

        /* --- Hintergrund des aktiven Menuepunkts --- */
        .dropdown-item--active {
            background-color: #d3f3ff;
        }

        /* =============================================
           Spot7 Shopping List Dropdown
           ============================================= */

        /* --- "Neue Liste erstellen" Button: weisser Text auf Spot7-Blau --- */
        .header-row__dropdown-footer .btn.btn--full {
            background-color: #19a6ff;
            color: #ffffff;
            border-color: #19a6ff;
        }

        .header-row__dropdown-footer .btn.btn--full:hover,
        .header-row__dropdown-footer .btn.btn--full:focus {
            background-color: #19a6ff;
            color: #ffffff;
            border-color: #19a6ff;
        }

        /* --- Ausgewaehlte Shopping List (Default): Textfarbe --- */
        .shopping-list-dropdown__item--default .shopping-list-dropdown__name {
            color: #19a6ff;
        }
    </style>
{% endblock %}
