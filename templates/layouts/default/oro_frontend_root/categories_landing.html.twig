                    <div class="smart-building__layer-icon smart-building__layer-icon--cloud">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#19a6ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                    </div>
                    <div class="smart-building__layer-content">
                        <p class="smart-building__layer-name">{{ 'spot7.smart_building.layer_cloud_name'|trans }}</p>
                        <p class="smart-building__layer-desc">{{ 'spot7.smart_building.layer_cloud_desc'|trans }}</p>
                    </div>
                    <span class="smart-building__layer-tag">{{ 'spot7.smart_building.layer_cloud_tag'|trans }}</span>
                </div>

                <div class="smart-building__connector"></div>

                {# Gateway Layer #}
