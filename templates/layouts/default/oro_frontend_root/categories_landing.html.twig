                    </div>
                    <div class="smart-building__layer-content">
                        <p class="smart-building__layer-name">{{ 'spot7.smart_building.layer_gateway_name'|trans }}</p>
                        <p class="smart-building__layer-desc">{{ 'spot7.smart_building.layer_gateway_desc'|trans }}</p>
                    </div>
                    <span class="smart-building__layer-tag">{{ 'spot7.smart_building.layer_gateway_tag'|trans }}</span>
                </div>

                <div class="smart-building__connector"></div>

                {# Network Layer #}
                <div class="smart-building__layer">
                    <div class="smart-building__layer-icon smart-building__layer-icon--network">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3a7ca5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                    </div>
                    <div class="smart-building__layer-content">
                        <p class="smart-building__layer-name">{{ 'spot7.smart_building.layer_network_name'|trans }}</p>
                        <p class="smart-building__layer-desc">{{ 'spot7.smart_building.layer_network_desc'|trans }}</p>
                    </div>
                    <span class="smart-building__layer-tag">{{ 'spot7.smart_building.layer_network_tag'|trans }}</span>
                </div>

                <div class="smart-building__connector"></div>

                {# Device Layer #}
                <div class="smart-building__layer">
                    <div class="smart-building__layer-icon smart-building__layer-icon--devices">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#214061" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                    </div>
                    <div class="smart-building__layer-content">
                        <p class="smart-building__layer-name">{{ 'spot7.smart_building.layer_devices_name'|trans }}</p>
                        <p class="smart-building__layer-desc">{{ 'spot7.smart_building.layer_devices_desc'|trans }}</p>
                    </div>
                    <span class="smart-building__layer-tag">{{ 'spot7.smart_building.layer_devices_tag'|trans }}</span>
                </div>

                <div class="smart-building__connector"></div>

                {# Infrastructure Layer #}
                <div class="smart-building__layer">
                    <div class="smart-building__layer-icon smart-building__layer-icon--infrastructure">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4a6a80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </div>
                    <div class="smart-building__layer-content">
                        <p class="smart-building__layer-name">{{ 'spot7.smart_building.layer_infra_name'|trans }}</p>
                        <p class="smart-building__layer-desc">{{ 'spot7.smart_building.layer_infra_desc'|trans }}</p>
                    </div>
