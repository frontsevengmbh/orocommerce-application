{% block _category_cards_styles_widget %}
    <style>
        /* =============================================
           Spot7 Category Cards – Felix-Style Landing
           Image backgrounds with text overlay
           ============================================= */

        .category-cards {
            max-width: 1400px;
            margin: 0 auto;
            padding: 60px 24px 40px;
        }

        .category-cards__heading {
            text-align: center;
            margin-bottom: 48px;
        }

        .category-cards__title {
            font-size: 52px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: #1d1d1f;
            margin: 0 0 12px;
            line-height: 1.08;
        }

        .category-cards__title span {
            background: linear-gradient(135deg, #19a6ff 0%, #214061 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .category-cards__subtitle {
            font-size: 18px;
            color: #86868b;
            font-weight: 400;
            margin: 0;
        }

        /* --- Grid Layout --- */
        .category-cards__grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
        }

        /* --- Individual Card --- */
        .category-card {
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            min-height: 380px;
            border-radius: 20px;
            overflow: hidden;
            text-decoration: none;
            color: #ffffff;
            cursor: pointer;
            transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                        box-shadow 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .category-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
            color: #ffffff;
            text-decoration: none;
        }

        /* --- Background Image --- */
        .category-card__bg {
            position: absolute;
            inset: 0;
            background-size: 65%;
            background-position: center;
            background-repeat: no-repeat;
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            z-index: 0;
        }

        .category-card:hover .category-card__bg {
            transform: scale(1.08);
        }

        /* --- Sensor-Bild Zentrierung (Bild ist im PNG leicht links) --- */
        .category-card--sensors .category-card__bg,
        .category-card--sensor .category-card__bg {
            background-position: 60% center;
            background-size: 50%;
        }

        /* --- Gradient Overlay --- */
        .category-card__overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to top,
                rgba(0, 0, 0, 0.7) 0%,
                rgba(0, 0, 0, 0.3) 40%,
                rgba(0, 0, 0, 0.05) 100%
            );
            z-index: 1;
            transition: background 0.4s ease;
        }

        .category-card:hover .category-card__overlay {
            background: linear-gradient(
                to top,
                rgba(33, 64, 97, 0.85) 0%,
                rgba(33, 64, 97, 0.4) 40%,
                rgba(33, 64, 97, 0.05) 100%
            );
        }

        /* --- Card Content --- */
        .category-card__content {
            position: relative;
            z-index: 2;
            padding: 28px 24px;
        }

        .category-card__name {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.01em;
            line-height: 1.2;
            margin: 0 0 8px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .category-card__cta {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.85);
            opacity: 0;
            transform: translateY(8px);
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .category-card:hover .category-card__cta {
            opacity: 1;
            transform: translateY(0);
        }

        .category-card__cta-arrow {
            display: inline-block;
            transition: transform 0.3s ease;
        }

        .category-card:hover .category-card__cta-arrow {
            transform: translateX(4px);
        }

        /* --- Accent Dot (top-left corner) --- */
        .category-card__accent {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 2;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #19a6ff;
            opacity: 0;
            transform: scale(0);
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .category-card:hover .category-card__accent {
            opacity: 1;
            transform: scale(1);
        }

        /* --- Short Description --- */
        .category-card__short {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            margin: 0 0 8px;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* --- Empty State --- */
        .category-cards__empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: 60px 24px;
            color: #86868b;
            font-size: 16px;
        }

        /* =============================================
           Responsive
           ============================================= */

        /* Tablet: 3 columns top, 2 bottom */
        @media (max-width: 1100px) {
            .category-cards__grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .category-card {
                min-height: 320px;
            }

            .category-cards__title {
                font-size: 40px;
            }
        }

        /* Mobile large: 2 columns */
        @media (max-width: 768px) {
            .category-cards {
                padding: 40px 16px 24px;
            }

            .category-cards__grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 14px;
            }

            .category-card {
                min-height: 260px;
            }

            .category-card__name {
                font-size: 20px;
            }

            .category-cards__title {
                font-size: 32px;
            }

            .category-cards__subtitle {
                font-size: 16px;
            }
        }

        /* Mobile small: 1 column */
        @media (max-width: 480px) {
            .category-cards__grid {
                grid-template-columns: 1fr;
            }

            .category-card {
                min-height: 220px;
            }
        }

        /* =============================================
           Spot7 Smart Building System – Felix-Style
           ============================================= */

        .smart-building {
            max-width: 1400px;
            margin: 0 auto;
            padding: 100px 24px;
        }

        /* --- Hero Section --- */
        .smart-building__hero {
            text-align: center;
            margin-bottom: 80px;
        }

        .smart-building__badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 100px;
            background: linear-gradient(135deg, rgba(25, 166, 255, 0.12), rgba(33, 64, 97, 0.1));
            color: #19a6ff;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .smart-building__hero-title {
            font-size: 52px;
            font-weight: 700;
            letter-spacing: -0.03em;
            line-height: 1.08;
            color: #1d1d1f;
            margin: 0 0 20px;
        }

        .smart-building__hero-title span {
            background: linear-gradient(135deg, #19a6ff 0%, #214061 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .smart-building__hero-desc {
            font-size: 20px;
            line-height: 1.5;
            color: #86868b;
            max-width: 680px;
            margin: 0 auto;
        }

        /* --- Architecture Diagram --- */
        .smart-building__diagram {
            position: relative;
            background: linear-gradient(180deg, #f5f5f7 0%, #ffffff 100%);
            border-radius: 28px;
            padding: 60px 40px;
            margin-bottom: 80px;
            overflow: hidden;
        }

        .smart-building__diagram::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(25, 166, 255, 0.06) 0%, transparent 70%);
            pointer-events: none;
        }

        .smart-building__diagram-title {
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #86868b;
            margin: 0 0 48px;
        }

        /* --- Layers Stack --- */
        .smart-building__layers {
            display: flex;
            flex-direction: column;
            gap: 16px;
            max-width: 900px;
            margin: 0 auto;
        }

        .smart-building__layer {
            display: flex;
            align-items: center;
            gap: 24px;
            padding: 24px 32px;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
        }

        .smart-building__layer:hover {
            transform: translateX(8px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        }

        .smart-building__layer-icon {
            flex-shrink: 0;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .smart-building__layer-icon--cloud {
            background: linear-gradient(135deg, #e6f4ff, #cceaff);
        }
        .smart-building__layer-icon--gateway {
            background: linear-gradient(135deg, #e0f0ff, #b8dfff);
        }
        .smart-building__layer-icon--network {
            background: linear-gradient(135deg, #dce8f0, #b0c8d8);
        }
        .smart-building__layer-icon--devices {
            background: linear-gradient(135deg, #e6eef4, #c8d8e4);
        }
        .smart-building__layer-icon--infrastructure {
            background: linear-gradient(135deg, #eef2f5, #d8e0e8);
        }

        .smart-building__layer-content {
            flex: 1;
        }

        .smart-building__layer-name {
            font-size: 17px;
            font-weight: 600;
            color: #1d1d1f;
            margin: 0 0 4px;
        }

        .smart-building__layer-desc {
            font-size: 14px;
            color: #86868b;
            margin: 0;
            line-height: 1.4;
        }

        .smart-building__layer-tag {
            flex-shrink: 0;
            padding: 4px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(25, 166, 255, 0.08);
            color: #19a6ff;
        }

        /* --- Connector Lines between layers --- */
        .smart-building__connector {
            display: flex;
            justify-content: center;
            height: 0;
            position: relative;
        }

        .smart-building__connector::after {
            content: '';
            position: absolute;
            width: 2px;
            height: 16px;
            top: -8px;
            background: linear-gradient(to bottom, #19a6ff, rgba(25, 166, 255, 0.2));
            border-radius: 1px;
        }

        /* --- Features Grid --- */
        .smart-building__features {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .smart-building__feature {
            text-align: center;
            padding: 48px 32px;
            border-radius: 20px;
            background: #f5f5f7;
            transition: transform 0.3s ease, background 0.3s ease;
        }

        .smart-building__feature:hover {
            transform: translateY(-4px);
            background: #eef2f5;
        }

        .smart-building__feature-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 24px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            background: linear-gradient(135deg, #214061, #19a6ff);
            color: #ffffff;
            box-shadow: 0 8px 24px rgba(25, 166, 255, 0.2);
        }

        .smart-building__feature-title {
            font-size: 20px;
            font-weight: 600;
            color: #1d1d1f;
            margin: 0 0 10px;
        }

        .smart-building__feature-desc {
            font-size: 15px;
            line-height: 1.5;
            color: #86868b;
            margin: 0;
        }

        /* --- CTA Section --- */
        .smart-building__cta {
            text-align: center;
            margin-top: 72px;
        }

        .smart-building__cta-text {
            font-size: 28px;
            font-weight: 600;
            color: #1d1d1f;
            margin: 0 0 24px;
            letter-spacing: -0.01em;
        }

        .smart-building__cta-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 16px 36px;
            border-radius: 100px;
            background: linear-gradient(135deg, #214061 0%, #19a6ff 100%);
            color: #ffffff;
            font-size: 17px;
            font-weight: 600;
            text-decoration: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 16px rgba(25, 166, 255, 0.3);
        }

        .smart-building__cta-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(25, 166, 255, 0.4);
            color: #ffffff;
            text-decoration: none;
        }

        .smart-building__cta-btn-arrow {
            transition: transform 0.3s ease;
        }

        .smart-building__cta-btn:hover .smart-building__cta-btn-arrow {
            transform: translateX(4px);
        }

        /* --- Smart Building Responsive --- */
        @media (max-width: 1100px) {
            .smart-building__hero-title {
                font-size: 40px;
            }

            .smart-building__features {
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
            }
        }

        @media (max-width: 768px) {
            .smart-building {
                padding: 60px 16px;
            }

            .smart-building__hero {
                margin-bottom: 48px;
            }

            .smart-building__hero-title {
                font-size: 32px;
            }

            .smart-building__hero-desc {
                font-size: 17px;
            }

            .smart-building__diagram {
                padding: 40px 20px;
                margin-bottom: 48px;
            }

            .smart-building__layer {
                padding: 18px 20px;
                gap: 16px;
            }

            .smart-building__layer-tag {
                display: none;
            }

            .smart-building__features {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .smart-building__feature {
                padding: 32px 24px;
            }

            .smart-building__cta-text {
                font-size: 22px;
            }
        }
    </style>
{% endblock %}

{% block _category_cards_section_widget %}
    {# =============================================
       Dynamische Kategorie-Karten: Werden automatisch aus dem
       OroCommerce Admin Panel (Master Catalog) geladen.
       Neue Kategorien im Admin anlegen → erscheinen hier automatisch.
       categories wird via Layout-YAML injiziert (categories_landing.yml)

       Fallback-Bilder: Wenn im Admin kein "Small Image" hochgeladen
       ist, wird ein Standard-Produktbild anhand des Namens verwendet.
       ============================================= #}

    {# --- Fallback-Bilder fuer bekannte Kategorien --- #}
    {% set fallback_images = {
        'e-paper':          '/images/spot7label_Standard_8-23.png',
        'beacons':          '/images/spot7nano_Standard_8-23.png',
        'anchors':          '/images/spot7anchor_Standard_8-23.png',
        'anchor':           '/images/spot7anchor_Standard_8-23.png',
        'sensors':          '/images/doorsensor.png',
        'sensor':           '/images/doorsensor.png',
        'wirepas gateway':  '/images/vortext_gehauese_01.png',
        'gateway':          '/images/vortext_gehauese_01.png',
        'gateways':         '/images/vortext_gehauese_01.png'
    } %}

    <section class="category-cards">
        <div class="category-cards__heading">
            <h2 class="category-cards__title">{{ 'spot7.landing.title_prefix'|trans }} <span>{{ 'spot7.landing.title_highlight'|trans }}</span></h2>
            <p class="category-cards__subtitle">{{ 'spot7.landing.subtitle'|trans }}</p>
        </div>

        <div class="category-cards__grid">
            {% for cat in categories %}
                {# Bild-Prioritaet: 1) Admin Small Image  2) Fallback nach Name  3) kein Bild #}
                {% if cat.small_image %}
                    {% set card_image = file_url(cat.small_image) %}
                {% elseif fallback_images[cat.title|lower] is defined %}
                    {% set card_image = fallback_images[cat.title|lower] %}
                {% else %}
                    {% set card_image = null %}
                {% endif %}

                <a href="{{ path('oro_product_frontend_product_index', { categoryId: cat.id, includeSubcategories: 1 }) }}"
                   class="category-card category-card--{{ cat.title|lower|replace({' ': '-'}) }}">
                    <div class="category-card__bg"
                         style="{% if card_image %}background-image: url('{{ card_image }}');{% endif %} background-color: #214061;">
                    </div>
                    <div class="category-card__overlay"></div>
                    <span class="category-card__accent"></span>
                    <div class="category-card__content">
                        <h3 class="category-card__name">{{ cat.title }}</h3>
                        {% if cat.short %}
                            <p class="category-card__short">{{ cat.short }}</p>
                        {% endif %}
                        <span class="category-card__cta">
                            {{ 'spot7.landing.card_cta'|trans }} <span class="category-card__cta-arrow">&rarr;</span>
                        </span>
                    </div>
                </a>
            {% else %}
                {# Fallback wenn noch keine Kategorien angelegt sind #}
                <div class="category-cards__empty">
                    <p>{{ 'spot7.landing.empty_state'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block _smart_building_section_widget %}
    <section class="smart-building">

        {# === Hero === #}
        <div class="smart-building__hero">
            <div class="smart-building__badge">{{ 'spot7.smart_building.badge'|trans }}</div>
            <h2 class="smart-building__hero-title">
                {{ 'spot7.smart_building.hero_title_line1'|trans }}<br>
                {{ 'spot7.smart_building.hero_title_line2'|trans }} <span>{{ 'spot7.smart_building.hero_title_highlight'|trans }}</span>
            </h2>
            <p class="smart-building__hero-desc">
                {{ 'spot7.smart_building.hero_desc'|trans }}
            </p>
        </div>

        {# === Architecture Diagram === #}
        <div class="smart-building__diagram">
            <p class="smart-building__diagram-title">{{ 'spot7.smart_building.diagram_title'|trans }}</p>

            <div class="smart-building__layers">
                {# Cloud Layer #}
